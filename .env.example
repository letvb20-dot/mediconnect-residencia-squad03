# Copie este arquivo para .env e preencha com suas credenciais reais.
# O .env é ignorado pelo git (ver .gitignore) — NUNCA comite credenciais.

# Supabase (backend do projeto)
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co
VITE_API_BASE_URL=https://<seu-projeto>.supabase.co/functions/v1
VITE_SUPABASE_REST_URL=https://<seu-projeto>.supabase.co/rest/v1
VITE_SUPABASE_FUNCTIONS_URL=https://<seu-projeto>.supabase.co/functions/v1
VITE_SUPABASE_STORAGE_URL=https://<seu-projeto>.supabase.co/storage/v1
VITE_SUPABASE_ANON_KEY=<sua-chave-anon-publica-do-supabase>

# IA generativa opcional: chave do Google Gemini para o chatbot e o preenchimento por voz.
# Gere em https://aistudio.google.com/app/apikey
# Sem chave, a IA roda em modo heurístico/local (sem voz).
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
