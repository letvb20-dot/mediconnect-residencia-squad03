# ────────────────────────────────────────────────────────────
# MediConnect ML Engine — Environment Variables Template
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────

# PostgreSQL connection string (SQLAlchemy format)
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/mediconnect

# Clinic coordinates for distance calculation
CLINIC_LAT=-23.550520
CLINIC_LON=-46.633308

# Model artifact storage path (relative to ml-engine/)
MODEL_DIR=models

# API server port
PORT=8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Optional: Weather API (default = Open-Meteo, no key needed) ───
# If you prefer OpenWeatherMap, set these:
# OPENWEATHER_API_KEY=your_api_key_here
# WEATHER_PROVIDER=openweathermap   # default: open-meteo

# ─── Optional: CEP geocoding ─────────────────────────────────────
# Uses ViaCEP + haversine by default (no key needed)
# CEP_PROVIDER=viacep

# ─── Retraining schedule (cron syntax) ───────────────────────────
# Default: every Monday at 02:00 AM (Brasília time)
RETRAIN_CRON=0 2 * * 1
RETRAIN_TIMEZONE=America/Sao_Paulo

# ─── Minimum dataset size for real training ───────────────────────
# If fewer rows than this, synthetic data is used instead
MIN_TRAINING_ROWS=200
